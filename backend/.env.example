# Plantilla de configuracion local. SOLO NOMBRES, ningun valor.
#
# El repo es publico (FR-028). Copiar a .env —que esta en .gitignore— y
# completar ahi. El servicio NO arranca si falta alguna de las obligatorias.

# --- Obligatorias ---

# Cadena de conexion a Postgres. En Railway la provee el servicio de base.
DATABASE_URL=

# Origenes autorizados a consumir el API, separados por coma (FR-023).
# Ej: el sitio de Pages y, mas adelante, el dominio propio.
CORS_ORIGENES=

# Cliente OAuth de Google. El ID es publico y tambien viaja al navegador;
# aca lo usa el servicio para validar el destinatario del token (FR-007).
GOOGLE_CLIENT_ID=

# Clave del proveedor de mail. Es un secreto real.
CORREO_API_KEY=

# Direccion desde la que sale el codigo. Sobre el subdominio de envio.
CORREO_REMITENTE=

# Direcciones administradoras, separadas por coma (FR-022). No hay columna
# de admin en la base: se decide comparando contra esto.
ADMIN_EMAILS=

# --- Opcionales, con valor por defecto ---

# Puerto de escucha. Railway lo inyecta solo.
PORT=

# Duracion de la sesion. Por defecto 4 semanas (FR-017).
SESION_DURACION=

# Cuanto se conserva el rastro de ingresos. Por defecto 90 dias (FR-022c).
RASTRO_RETENCION=
