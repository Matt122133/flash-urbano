<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Un solo host, y es el que el emulador usa para ver el `localhost` de la
         maquina de desarrollo. NO se habilita texto plano en general: si
         `cleartextTrafficPermitted` estuviera en `base-config`, cualquier
         destino quedaria habilitado. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
